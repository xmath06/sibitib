# ===== Server =====
PORT=3000
NODE_ENV=development
# Origin(s) frontend yang diizinkan, pisahkan dengan koma. Contoh: http://localhost:5173,https://app.example.com
CORS_ORIGIN=http://localhost:5173

# ===== Database (Neon Serverless Postgres) =====
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbt

# ===== JWT Secret (harus panjang & acak di production) =====
JWT_SECRET=change-me-to-a-very-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# true ketika di belakang HTTPS (Render/SnapDeploy); untuk local HTTP set false
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ===== S3-compatible Object Storage (Cloudflare R2 / AWS S3) =====
# Belum punya S3/R2? Isi placeholder di bawah ini (app tetap jalan; hanya fitur
# upload gambar editor yang gagal). Ganti dengan kredensial asli saat bucket siap.
S3_ENDPOINT=https://not-configured.invalid
S3_REGION=auto
S3_BUCKET=placeholder
S3_ACCESS_KEY_ID=placeholder
S3_SECRET_ACCESS_KEY=placeholder
S3_PUBLIC_BASE_URL=https://not-configured.invalid
S3_FORCE_PATH_STYLE=true
