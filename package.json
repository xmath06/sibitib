{
  "name": "cbt-lms-backend",
  "version": "1.0.0",
  "description": "CBT (Computer Based Test) & LMS Backend API - Bun + ElysiaJS + Drizzle + PostgreSQL",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "TZ=Asia/Jakarta bun --watch src/index.ts",
    "start": "TZ=Asia/Jakarta bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/stream": "^1.1.0",
    "@elysiajs/swagger": "^1.3.1",
    "bcryptjs": "^3.0.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "linkedom": "^0.18.13",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
