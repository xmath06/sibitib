# ===== Server =====
PORT=3000
NODE_ENV=development
# Origin(s) frontend yang diizinkan, pisahkan dengan koma. Contoh: http://localhost:5173,https://app.example.com
CORS_ORIGIN=http://localhost:5173

# ===== Database (Neon Serverless Postgres) =====
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cbt

# ===== JWT Secret (harus panjang & acak di production) =====
JWT_SECRET=change-me-to-a-very-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# true ketika di belakang HTTPS (Render/SnapDeploy); untuk local HTTP set false
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

# ===== S3-compatible Object Storage (Cloudflare R2 / AWS S3) =====
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
